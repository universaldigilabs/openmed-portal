# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (SUPABASE + NEXT.JS)
# ==============================================================================

# Public Supabase credentials (exposed to client-side React code)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Secret Server-Only Supabase credential (NEVER expose to client side)
# Bypasses Row Level Security (RLS) for the Coordinator Dashboard & Admin APIs
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Base URL for local development / production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Coordinator PIN or Secret for lightweight access protection
COORDINATOR_ACCESS_CODE=coordinator2026
